{
  "name": "redesign-v3-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "node scripts/install-reactbits.mjs",
    "originals:install": "node scripts/install-reactbits.mjs",
    "originals:verify": "node scripts/verify-originals.mjs",
    "verify": "node scripts/verify-app.mjs --stage=all",
    "measure:weights": "node scripts/measure-weights.mjs",
    "measure:lighthouse": "node scripts/measure-lighthouse.mjs",
    "verify:home": "node scripts/verify-home.mjs --stage=all",
    "measure:home": "node scripts/measure-home.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "test:pending": "node --test scripts/test-pending.mjs",
    "measure": "npm run build && npm run measure:weights && npm run measure:lighthouse"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
