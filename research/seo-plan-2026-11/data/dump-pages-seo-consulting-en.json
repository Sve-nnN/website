      {
        "id": "6a544f71140e75434aba4dda",
        "caseStudy": 14,
        "blockName": null,
        "blockType": "relatedCaseStudyBlock",
        "title": "A real example of how I work",
        "framingText": "There isn't a published case study for ongoing consulting yet, but here's a genuine example of how I approach working with clients."
      },
      {
        "id": "6a544f71140e75434aba4ddf",
        "blockName": null,
        "faqs": [
          {
            "id": "6a544f71140e75434aba4ddb",
            "question": "How is an ongoing consulting engagement structured?",
            "answer": {
              "root": {
                "type": "root",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "We set a cadence (monthly, biweekly, or weekly depending on need) with a clear scope for what gets reviewed each cycle. It's not an open-ended contract with no goals: every cycle has concrete deliverables, and scope can adjust over time.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  }
                ],
                "direction": "ltr"
              }
            }
          },
          {
            "id": "6a544f71140e75434aba4ddc",
            "question": "How is this different from the technical audit?",
            "answer": {
              "root": {
                "type": "root",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "The audit is a point-in-time diagnostic focused on a specific moment. Consulting is continuous: monitoring, re-prioritizing, and reviewing changes over time, for sites that keep evolving and can't rely on a single snapshot.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  }
                ],
                "direction": "ltr"
              }
            }
          },
          {
            "id": "6a544f71140e75434aba4ddd",
            "question": "Do you work directly with my dev team?",
            "answer": {
              "root": {
                "type": "root",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "Yes, and that's where I add the most value versus a traditional consultant. Since I'm also a full-stack developer, I can review code, take part in architecture decisions, or implement changes myself, instead of just handing off recommendations the dev team has to translate.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  }
                ],
                "direction": "ltr"
              }
            }
          },
          {
            "id": "6a544f71140e75434aba4dde",
            "question": "What's the minimum commitment?",
            "answer": {
              "root": {
                "type": "root",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "It depends on the project. We figure it out based on the site's current state and expected rate of change. There's no fixed package: the quote is scoped after understanding the context.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  }
                ],
                "direction": "ltr"
              }
            }
          }
        ],
        "blockType": "faq",
        "title": "Frequently asked questions"
