        "blockType": "hero",
        "title": "AI SEO / GEO",
        "subtitle": "More and more searches end in an AI-generated answer (ChatGPT, Perplexity, Google AI Overviews) with no click on any result at all. If your content isn't structured for those systems to read and cite, the answer cites your competitor instead.",
        "cityName": null,
        "inlineStat": null
      },
      {
        "id": "6a53ff9c8f92aa73aaf6d3e0",
        "blockName": null,
        "columns": [
          {
            "id": "6a53ff9c8f92aa73aaf6d3dc",
            "size": "full",
            "enableLink": null,
            "richText": {
              "root": {
                "type": "root",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "tag": "h2",
                    "type": "heading",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "If your content isn't citable, someone else gets the mention",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  },
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "More and more searches end in an AI-generated answer with no click on any result at all. If your content is scattered across the page, without clear, self-contained passages, an AI system can't pull it out or cite it.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  },
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "More content isn't the fix. The fix is restructuring what already exists so it's readable by both traditional search engines and the answer engines that are changing how people search.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  }
                ],
                "direction": "ltr"
              }
            },
            "link": {
              "type": "reference",
              "newTab": null,
              "url": null,
              "label": null,
              "appearance": "default"
            }
          }
        ],
        "blockType": "content"
      },
      {
        "id": "6a544f9c140e75434aba4df0",
        "blockName": null,
        "blockType": "serviceScopeCard",
        "title": "Scope of this work",
        "scope": "Structuring content to be citable, plus implementing and maintaining a machine-readable manifest (`llms.txt`/`llms-full.txt`).",
        "outcome": "Content with a better shot at getting cited in ChatGPT, Perplexity, and Google AI Overviews answers, not just indexed.",
        "timeline": "2 to 3 weeks"
      },
      {
        "id": "6a53ff9c8f92aa73aaf6d3e7",
        "blockName": null,
        "links": [
          {
