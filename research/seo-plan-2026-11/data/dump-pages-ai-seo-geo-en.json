      {
        "id": "6a544f9c140e75434aba4dfd",
        "blockName": null,
        "faqs": [
          {
            "id": "6a544f9c140e75434aba4df9",
            "question": "What is GEO and how is it different from traditional SEO?",
            "answer": {
              "root": {
                "type": "root",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "GEO (Generative Engine Optimization) is optimizing content so AI answer engines cite it directly in their responses, instead of just ranking it in a results list. It shares fundamentals with traditional SEO (structure, semantics, authority) but adds a new layer: making content readable and citable by systems that generate text, not just crawlers that index pages.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  }
                ],
                "direction": "ltr"
              }
            }
          },
          {
            "id": "6a544f9c140e75434aba4dfa",
            "question": "How do you measure the success of a GEO strategy?",
            "answer": {
              "root": {
                "type": "root",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "It's a newer field than traditional SEO, so metrics are still maturing. Today you can track whether your brand gets cited in ChatGPT, Perplexity, or AI Overviews responses for relevant queries, and monitor referral traffic from those platforms when they report it. There's no single 'ranking' yet like in Google, but there are verifiable citation signals.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  }
                ],
                "direction": "ltr"
              }
            }
          },
          {
            "id": "6a544f9c140e75434aba4dfb",
            "question": "What exactly is the llms.txt file?",
            "answer": {
              "root": {
                "type": "root",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "It's a plain-text manifest meant to help AI agents quickly understand what your site is about and where to find relevant content, without having to crawl all the HTML. It's an emerging standard, similar in spirit to robots.txt, but aimed at AI instead of traditional crawlers. This site already implements it: you can see it at /llms.txt.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  }
                ],
                "direction": "ltr"
              }
            }
          },
          {
            "id": "6a544f9c140e75434aba4dfc",
            "question": "Does this replace traditional SEO?",
            "answer": {
              "root": {
                "type": "root",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "type": "paragraph",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "text": "No, it complements it. Traditional SEO is still necessary to show up in conventional search results. GEO is an additional layer for the fastest-growing search channel: AI-generated answers.",
                        "type": "text",
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  }
                ],
                "direction": "ltr"
              }
            }
          }
        ],
        "blockType": "faq",
        "title": "Frequently asked questions"
