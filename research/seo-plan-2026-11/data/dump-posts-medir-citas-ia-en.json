                        "type": "paragraph",
                        "format": "",
                        "indent": 0,
                        "version": 1,
                        "children": [
                          {
                            "mode": "normal",
                            "text": "Not separately. Google includes them in normal web performance, mixed in with classic results.",
                            "type": "text",
                            "style": "",
                            "detail": 0,
                            "format": 0,
                            "version": 1
                          }
                        ],
                        "direction": "ltr",
                        "textFormat": 0
                      }
                    ],
                    "direction": "ltr"
                  }
                },
                "question": "Can I see AI Overview clicks in Search Console?"
