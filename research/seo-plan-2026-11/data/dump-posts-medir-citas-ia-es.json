                      {
                        "type": "paragraph",
                        "format": "",
                        "indent": 0,
                        "version": 1,
                        "children": [
                          {
                            "mode": "normal",
                            "text": "No lo separa bien por defecto. Lo más fiable es crear un canal personalizado con una expresión regular que capture los dominios de los asistentes y ubicarlo antes de Referral en el grupo de canales.",
                            "type": "text",
                            "style": "",
                            "detail": 0,
                            "format": 0,
                            "version": 1
                          }
                        ],
                        "direction": "ltr",
                        "textFormat": 0
                      }
                    ],
                    "direction": "ltr"
                  }
                },
                "question": "¿GA4 detecta el tráfico de ChatGPT automáticamente?"
              },
