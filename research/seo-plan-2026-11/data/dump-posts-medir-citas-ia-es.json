                      {
                        "type": "paragraph",
                        "format": "",
                        "indent": 0,
                        "version": 1,
                        "children": [
                          {
                            "mode": "normal",
                            "text": "No por separado. Google los incluye en el rendimiento web normal, mezclados con los resultados clásicos.",
                            "type": "text",
                            "style": "",
                            "detail": 0,
                            "format": 0,
                            "version": 1
                          }
