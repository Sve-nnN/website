          "textFormat": 0
        },
        {
          "type": "block",
          "fields": {
            "id": "1794935431878f3affd",
            "faqs": [
              {
                "id": "f5a95b718e2507689a5832db",
                "answer": {
                  "root": {
                    "type": "root",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "type": "paragraph",
                        "format": "",
                        "indent": 0,
                        "version": 1,
                        "children": [
                          {
                            "mode": "normal",
                            "text": "No. Es una propuesta abierta publicada en llmstxt.org en septiembre de 2024. Ningún buscador ni empresa de IA lo adoptó como requisito.",
                            "type": "text",
                            "style": "",
                            "detail": 0,
                            "format": 0,
                            "version": 1
                          }
                        ],
                        "direction": "ltr",
                        "textFormat": 0
                      }
                    ],
                    "direction": "ltr"
                  }
                },
                "question": "¿El llms.txt es un estándar oficial?"
              },
              {
                "id": "3bc6b335196c05e500ae9c5c",
                "answer": {
                  "root": {
                    "type": "root",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "type": "paragraph",
                        "format": "",
                        "indent": 0,
                        "version": 1,
                        "children": [
                          {
                            "mode": "normal",
                            "text": "No en su buscador. Google no pide ningún archivo especial para aparecer en los AI Overviews ni en el AI Mode, y miembros de su equipo de búsqueda dijeron en público que no lo usan.",
                            "type": "text",
                            "style": "",
                            "detail": 0,
                            "format": 0,
                            "version": 1
                          }
                        ],
                        "direction": "ltr",
                        "textFormat": 0
                      }
                    ],
                    "direction": "ltr"
                  }
                },
                "question": "¿Google usa el llms.txt?"
              },
              {
                "id": "106cb21a7a4f7958afcaca62",
                "answer": {
                  "root": {
                    "type": "root",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "type": "paragraph",
                        "format": "",
                        "indent": 0,
                        "version": 1,
                        "children": [
                          {
                            "mode": "normal",
                            "text": "El llms.txt es un índice con enlaces y notas cortas. El llms-full.txt reúne el texto completo de las páginas en un solo archivo, útil sobre todo para documentación técnica.",
                            "type": "text",
                            "style": "",
                            "detail": 0,
                            "format": 0,
                            "version": 1
                          }
                        ],
                        "direction": "ltr",
                        "textFormat": 0
                      }
                    ],
                    "direction": "ltr"
                  }
                },
                "question": "¿Qué diferencia hay entre llms.txt y llms-full.txt?"
              },
              {
                "id": "31c368bfba3decee296df222",
                "answer": {
                  "root": {
                    "type": "root",
                    "format": "",
                    "indent": 0,
                    "version": 1,
                    "children": [
                      {
                        "type": "paragraph",
                        "format": "",
                        "indent": 0,
                        "version": 1,
                        "children": [
                          {
                            "mode": "normal",
                            "text": "No, siempre que no exponga información interna ni contenido que no quieras publicar. Es un archivo público más y cualquiera lo puede leer.",
                            "type": "text",
                            "style": "",
                            "detail": 0,
                            "format": 0,
                            "version": 1
                          }
                        ],
                        "direction": "ltr",
                        "textFormat": 0
                      }
                    ],
                    "direction": "ltr"
                  }
                },
                "question": "¿Puede perjudicar mi SEO tener un llms.txt?"
              }
            ],
